# Database
#
# Local development can rely on SQLite and leave DATABASE_URL unset.
# Preview/production (and any local Postgres override) should set DATABASE_URL.
# When using Vercel Postgres, this is usually injected automatically per environment.
# Format:
#   postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
# Example:
#   DATABASE_URL=postgres://default:password@verceldb.example.com:5432/verceldb?sslmode=require

# DATABASE_URL=

# Media runtime
#
# Keep local as the safe default until the R2 cutover is validated.
# - local: resolve `/covers/*` from the app's committed public assets
# - r2: resolve `/covers/*` through the private R2-backed media route
# MEDIA_BACKEND=local

# Required for private R2 reads from the Vercel/Next.js media route
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional: check `.cache/covers` before R2. Usually useful only in development.
# MEDIA_CACHE_ENABLED=0

# Optional for Wrangler automation in CI/non-interactive shells.
# For local development, `bunx wrangler login` is usually enough.
# CLOUDFLARE_API_TOKEN=

# Optional direct public origin. Leave unset for private R2 delivery through
# `/api/media/covers/*`; do not use an r2.dev URL in production.
# R2_PUBLIC_BASE_URL=
