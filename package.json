{
  "name": "bukie",
  "version": "0.43.0",
  "private": true,
  "scripts": {
    "build": "bun run db:init:pg && next build",
    "build:ci": "next build",
    "build-storybook": "storybook build",
    "dev": "next dev",
    "db:generate": "bunx drizzle-kit generate",
    "db:generate:pg": "bunx drizzle-kit generate --config ./drizzle.config.pg.ts",
    "db:init": "bunx tsx ./scripts/db/init.ts",
    "db:verify": "bunx tsx ./scripts/db/verify-catalog.ts",
    "db:init:pg": "bun ./scripts/db/init.pg.ts",
    "db:reset": "bun ./scripts/db/reset.ts",
    "db:reseed": "bun run db:reset && bun run db:init",
    "db:catalog:rebuild": "bunx tsx ./scripts/db/rebuild-catalog.ts",
    "db:catalog:enrichment-sample": "bunx tsx ./scripts/db/run-enrichment-sample.ts",
    "db:catalog:description-sample": "bunx tsx ./scripts/db/run-description-enrichment-sample.ts",
    "db:catalog:cover-sample": "bunx tsx ./scripts/db/run-cover-enrichment-sample.ts",
    "db:catalog:enrichment-dry-run": "bunx tsx ./scripts/db/run-catalog-enrichment-dry-run.ts",
    "db:catalog:promote:preview": "bunx tsx ./scripts/db/promote-diagnostic-five-preview.ts",
    "lint": "bunx @biomejs/biome check --no-errors-on-unmatched .",
    "lint:fix": "bunx @biomejs/biome check --write --no-errors-on-unmatched .",
    "release": "semantic-release",
    "start": "bun run db:init:pg && next start",
    "start:ci": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "bunx vitest --config vitest.config.unit.ts --run",
    "test:coverage": "bunx vitest --config vitest.config.unit.ts --coverage --run",
    "test:playwright": "node ./scripts/test/run-playwright.mjs",
    "test:storybook": "bunx vitest --config vitest.config.storybook.ts",
    "images:optimize": "bun ./scripts/optimize-images.ts --webp --maxWidth 450 --quality 80",
    "images:optimize:r2": "bun run images:optimize && bun run covers:r2:backfill",
    "covers:fetch": "bunx tsx ./scripts/covers/fetch-covers.ts",
    "covers:fetch:r2": "bun run covers:fetch -- --upload-r2",
    "covers:prune": "bunx tsx ./scripts/covers/prune-unused.ts",
    "covers:suggest": "bunx tsx ./scripts/covers/suggest-mappings.ts",
    "covers:rename:id": "bunx tsx ./scripts/covers/rename-to-id.ts",
    "covers:canonicalize": "bunx tsx ./scripts/covers/canonicalize.ts",
    "covers:cache:hydrate": "bunx tsx ./scripts/covers/hydrate-cache.ts",
    "covers:report": "bunx tsx ./scripts/covers/report-footprint.ts",
    "covers:r2:backfill": "powershell -ExecutionPolicy Bypass -File ./scripts/covers/r2-sync.ps1 upload",
    "covers:r2:status": "powershell -ExecutionPolicy Bypass -File ./scripts/covers/r2-sync.ps1 status",
    "covers:r2:reconcile": "powershell -ExecutionPolicy Bypass -File ./scripts/covers/r2-sync.ps1 reconcile"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0-canary.99",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@chromatic-com/storybook": "^5.0.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/nextjs-vite": "^10.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "jsdom": "^29.0.0",
    "lefthook": "^2.1.4",
    "msw": "^2.12.11",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "semantic-release": "^25.0.3",
    "sharp": "^0.34.5",
    "storybook": "^10.2.19",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
